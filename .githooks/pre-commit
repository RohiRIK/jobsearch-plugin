#!/bin/sh
# Refuse to create a commit carrying personal contact details.
# Enable once with:  git config core.hooksPath .githooks
#
# Bypass deliberately with --no-verify if you are certain a match is a
# placeholder — then add it to ALLOWED in scripts/scan-personal-data.ts so the
# CI check agrees with you.

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found; skipping personal-data scan" >&2
  exit 0
fi

exec bun run scripts/scan-personal-data.ts --staged
