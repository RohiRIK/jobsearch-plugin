data/profile.json
data/profile.json.bak
data/staging/
data/reasoning.json
data/seen-jobs.json
data/pipeline-state.json
data/reports/
data/matches/
data/market/
data/upstream-cv/

# Agent runtime state / research scratch
.agent-state.md
.interceptor-research/

# Personal application output files (generated by /apply — do not share)
assets/cv/main_*.tex
assets/cv/main_*.typ
!assets/cv/main_example.tex
assets/cv/*.txt
assets/cv/template.typ
assets/cover_letters/cover_*.tex
assets/cover_letters/Cover_*.tex
assets/cover_letters/cover_*.typ

# Convention-named personal outputs (<Name>_<Company>_<Role>_CV|CL.*)
assets/cv/*_CV.*
assets/cover_letters/*_CL.*

# Grouped application output: assets/applications/<Company>/<Date>/ — all personal
assets/applications/

# docs/personal/ subfolder contents are personal — only README and folder structure are tracked
docs/personal/cv/**
docs/personal/linkedin/**
docs/personal/diplomas/**
docs/personal/references/**
docs/personal/applications/**
!docs/personal/**/.gitkeep

# Personal job search tracking
job_search_tracker.csv

# Upskill reports (personal output)
upskill/*.md

# Assets (personal/ephemeral)
assets/photos/
assets/logos/
assets/signatures/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/

# Skills lock (auto-generated)
skills-lock.json

# Agent skills: track the source, ignore only deps and logs.
# (A blanket `.agents/` ignore silently drops the job-search CLI skills from the repo.)
.agents/**/node_modules/
.agents/**/*.log
.agents/usage/

# Portfolio output (generated from personal profile)
assets/portfolio/

# Test fixtures (small committed PDFs for page-count tests — exempt from the *.pdf ignore)
!tests/fixtures/
!tests/fixtures/*.pdf

# Job descriptions and scratch fed into the tooling (personal inputs)
data/jd/
data/scratch/

# Belt-and-braces for loose personal files at the repo root. These belong in
# data/jd/ or data/scratch/, but an ad-hoc name at the root is exactly how the
# earlier batch escaped every pattern above.
/*_job.txt
/job.txt
/job-*.txt
/draft-*.json
/jd_*.txt
/*-jd.md
/*_jd.md
/*.cjs
/mcp_request.json
/texput.log
/_test-*.typ

# Personal CV/cover sources in the legacy flat dirs (the *_CV.* / *_CL.* rules
# above miss sources whose filename predates the naming convention).
!assets/cv/main_example.tex

# Typst fixture dirs left behind by a crashed test run
/.typst-fixture-*/

# Claude Code worktree state
/.worktrees/

# ─── Generated CVs and cover letters — anywhere in the tree ──────────────────
# The convention is <Name>_<Company>_<Role>_<CV|CL>.<ext>, so match the suffix
# rather than a directory: documents have escaped by being written to the repo
# root, and a stray one was even named _Cl.pdf (gitignore is case-sensitive on
# Linux, hence the variants). Shipped templates under templates/ and the
# example/class files in assets/ carry no _CV/_CL suffix and stay tracked.
*_CV.*
*_CL.*
*_Cv.*
*_Cl.*
*_cv.*
*_cl.*
*_CV
*_CL

# Any PDF or Typst/LaTeX source sitting loose at the repo root is a stray
# compile, never something worth committing.
/*.typ
/*.tex
/*.aux
/*.out

# Filled candidate profile — real contact details. The blank template is
# tracked as 01-candidate-profile.example.md; this copy never gets committed.
.claude/skills/job-application-assistant/01-candidate-profile.md

# jobsearch runtime state (call log, cache) and data-backup archives
data/state/
data/cache/
data/tools/
backups/
job-search/evals/results/

# Personal Claude Code context (candidate profile)
CLAUDE.local.md
